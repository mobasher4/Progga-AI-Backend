// Progga AI data model.
// Runs on PostgreSQL (e.g. Neon). Enum-like columns are plain strings validated
// by Zod in the API layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection: used by the app (serverless-friendly).
  url       = env("DATABASE_URL")
  // Direct connection: used by `prisma db push` / migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  role            String   @default("STUDENT") // STUDENT | PARENT | TEACHER | ADMIN
  grade           Int? // 3..12 (11-12 = HSC). Students only.
  language        String   @default("en") // en | bn
  avatarSkin      String   @default("classic")
  xp              Int      @default(0)
  coins           Int      @default(0)
  streakDays      Int      @default(0)
  bestStreak      Int      @default(0)
  lastActiveDate  String? // YYYY-MM-DD in Asia/Dhaka
  linkCode        String   @unique // shared with a parent/teacher to link accounts
  dailyTutorLimit Int      @default(25)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tutorSessions  TutorSession[]
  xpEvents       XpEvent[]
  badges         UserBadge[]
  items          UserItem[]
  questClaims    QuestClaim[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  safetyEvents   SafetyEvent[]
  guardianOf     GuardianLink[]   @relation("guardian")
  guardedBy      GuardianLink[]   @relation("student")
}

model GuardianLink {
  id         String   @id @default(cuid())
  guardianId String
  studentId  String
  createdAt  DateTime @default(now())
  guardian   User     @relation("guardian", fields: [guardianId], references: [id], onDelete: Cascade)
  student    User     @relation("student", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
}

// ── Socratic tutor ───────────────────────────────────────

model TutorSession {
  id            String         @id @default(cuid())
  studentId     String
  subject       String
  grade         Int
  mode          String // problem | concept | fact
  kind          String         @default("question") // question (asked by the student) | lesson (a syllabus topic taught from scratch)
  language      String         @default("en") // language the hidden plan is written in
  title         String
  topic         String         @default("")
  problemText   String
  hadImage      Boolean        @default(false)
  status        String         @default("active") // active | solved | abandoned
  plan          Json // hidden lesson plan (steps, expected answers, hints, final answer)
  progress      Json // per-step runtime state: attempts, hints shown, revealed
  currentStep   Int            @default(0)
  hintsUsed     Int            @default(0)
  wrongAttempts Int            @default(0)
  xpEarned      Int            @default(0)
  lessonId      String? // asked from inside this video lesson
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  student       User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson        Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages      TutorMessage[]

  @@index([studentId, createdAt])
}

model TutorMessage {
  id        String       @id @default(cuid())
  sessionId String
  role      String // student | tutor
  kind      String       @default("text") // text | question | hint | feedback | why | celebrate | recap | reveal | safety
  content   String
  stepIndex Int?
  meta      Json?
  createdAt DateTime     @default(now())
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speech    SpeechClip?

  @@index([sessionId, createdAt])
}

// Progga's spoken version of a tutor message (read-aloud), generated once and
// reused on replay. Keyed by voice/model so a settings change regenerates it.
/// NCTB chapters and topics for a class + subject without a seeded course, written once by the AI.
model SyllabusCache {
  grade     Int
  subject   String
  language  String
  chapters  Json // [{ title, topics: string[] }]
  createdAt DateTime @default(now())

  @@id([grade, subject, language])
}

model SpeechClip {
  messageId String       @id
  voice     String
  model     String
  audio     Bytes // audio/mpeg
  createdAt DateTime     @default(now())
  message   TutorMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model SafetyEvent {
  id        String   @id @default(cuid())
  userId    String
  category  String // unsafe | personal_info | off_topic | wellbeing
  excerpt   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ── Gamification ─────────────────────────────────────────

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String // tutor_step | tutor_step_clean | tutor_solved | lesson_complete | checkpoint | quiz_correct | quiz_finish | quest | streak
  refId     String?
  day       String // YYYY-MM-DD (Asia/Dhaka) for fast daily quest + streak queries
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
  @@index([createdAt])
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model UserItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model QuestClaim {
  id        String   @id @default(cuid())
  userId    String
  questId   String
  day       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, day])
}

// ── App settings (e.g. which AI provider/model is active) ──

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── Content: subjects, video lessons, quizzes ────────────

model Subject {
  id        String         @id // slug: math, science, ...
  name      String
  nameBn    String
  icon      String // emoji
  color     String // hex
  minGrade  Int
  maxGrade  Int
  order     Int            @default(0)
  lessons   Lesson[]
  questions QuizQuestion[]
  courses   Course[]
}

// A class-wise subject course that follows the NCTB textbook: Course → Chapter → Lesson (topic).
model Course {
  id          String    @id // slug: physics-10
  subjectId   String
  grade       Int
  title       String
  titleBn     String    @default("")
  book        String    @default("") // NCTB textbook the chapters follow
  description String    @default("")
  order       Int       @default(0)
  subject     Subject   @relation(fields: [subjectId], references: [id])
  chapters    Chapter[]

  @@unique([subjectId, grade])
}

model Chapter {
  id       String   @id // physics-10-ch2
  courseId String
  number   Int // NCTB chapter number
  title    String
  titleBn  String   @default("")
  summary  String   @default("")
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([courseId, number])
}

model Lesson {
  id          String           @id @default(cuid())
  subjectId   String
  grade       Int
  chapter     String
  title       String
  description String
  provider    String // youtube | mp4
  videoUrl    String // YouTube video id or mp4 URL
  durationSec Int
  xpReward    Int              @default(20)
  checkpoints Json // [{ atSec, question, options[], answerIndex, explanation }]
  order       Int              @default(0)
  // Course topics: the chapter they belong to and a written lesson (Markdown + $maths$)
  chapterId   String?
  body        String           @default("")
  readingMin  Int              @default(0)
  createdAt   DateTime         @default(now())
  subject     Subject          @relation(fields: [subjectId], references: [id])
  unit        Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  progress    LessonProgress[]
  questions   TutorSession[]

  @@index([subjectId, grade])
  @@index([chapterId, order])
}

model LessonProgress {
  id                 String   @id @default(cuid())
  userId             String
  lessonId           String
  watchedSec         Int      @default(0)
  checkpointsCorrect Json     @default("[]") // indexes answered correctly
  readDone           Boolean  @default(false) // written lesson marked as read
  completed          Boolean  @default(false)
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson             Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model QuizQuestion {
  id          String  @id @default(cuid())
  subjectId   String
  grade       Int
  topic       String
  prompt      String
  options     Json // string[]
  answerIndex Int
  explanation String
  difficulty  Int     @default(1) // 1..3
  subject     Subject @relation(fields: [subjectId], references: [id])

  @@index([subjectId, grade])
}

model QuizAttempt {
  id           String    @id @default(cuid())
  userId       String
  subjectId    String
  grade        Int
  questionIds  Json // string[]
  answers      Json // [{ questionId, choice, correct, ms }]
  combo        Int       @default(0)
  bestCombo    Int       @default(0)
  hearts       Int       @default(3)
  score        Int       @default(0)
  correctCount Int       @default(0)
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
