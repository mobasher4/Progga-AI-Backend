# â”€â”€ Server â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Local dev uses SQLite (zero setup). For production switch the provider in
# prisma/schema.prisma to "postgresql" and use a Postgres URL here.
DATABASE_URL="file:./dev.db"

# â”€â”€ Auth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Use a long random string in production: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=6a83a2c0b4c3254f00222f56a0dcff13cf31f3f67107f4543c7e97793768e19e4a28c0583e09b37d6ea483dfde44214c
JWT_EXPIRES_IN=7d

# â”€â”€ AI engine â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Starting engine: "openai" | "deepseek" | "anthropic" | "mock" (built-in offline tutor).
# If unset, the first provider with a key wins (OpenAI â†’ DeepSeek â†’ Claude), else mock.
# Admins can switch provider + models at runtime in the app: /admin (saved in the DB).
LLM_PROVIDER=

# Each provider uses ONE model for everything: planning steps, fact answers and checking replies.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (OpenAI-compatible API). deepseek-flash plans in ~10s; deepseek-v4-pro took ~45s in testing.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# â”€â”€ Kid-safety defaults â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Max new tutor problems a student can start per day (guardians can change per child)
DEFAULT_DAILY_TUTOR_LIMIT=25
