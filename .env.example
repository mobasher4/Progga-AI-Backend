# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────
# PostgreSQL (e.g. Neon: https://neon.tech). Copy both strings from the Neon
# dashboard → Connect. DATABASE_URL is the *pooled* one (host contains "-pooler"),
# DIRECT_URL is the direct one (no "-pooler"); it is used by `npm run setup`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth ─────────────────────────────────────────────────
# Use a long random string in production: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── AI engine ────────────────────────────────────────────
# Starting engine: "openai" | "deepseek" | "anthropic" | "ollama" | "mock" (built-in offline tutor).
# If unset, the first provider with a key wins (OpenAI → DeepSeek → Claude → Ollama), else mock.
# Admins can switch provider + models at runtime in the app: /admin (saved in the DB).
LLM_PROVIDER=

# Each provider uses ONE model for everything: planning steps, fact answers and checking replies.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Read-aloud (Progga speaks its replies). Set VOICE_ENABLED=false to turn it off.
# Voice engines: OpenAI (uses OPENAI_API_KEY), Google Gemini TTS and Azure Speech. Admins pick the
# engine and voice at runtime in the app: /admin → Progga's voice (saved in the DB).
VOICE_ENABLED=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_BASE_URL=https://api.openai.com/v1
# Google Gemini TTS: natural Bangla that follows the kid style. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Azure Speech: native Bangladeshi voices (bn-BD Nabanita, Pradeep). Key + region from the Azure portal.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Self-hosted IndicF5 (AI4Bharat) Bangla voice: see indicf5/README.md. Leave empty if not running it.
INDICF5_URL=

# DeepSeek (OpenAI-compatible API). deepseek-flash plans in ~10s; deepseek-v4-pro took ~45s in testing.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Local model via Ollama (https://ollama.com) — free, runs on this machine, no key.
# `ollama pull gemma4:12b`, then set the URL below to enable the "Local (Ollama)" engine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# Context window in tokens (Ollama defaults to 4096, too small for the tutor prompt)
OLLAMA_NUM_CTX=16384

# ── Kid-safety defaults ──────────────────────────────────
# Max new tutor problems a student can start per day (guardians can change per child)
DEFAULT_DAILY_TUTOR_LIMIT=25
