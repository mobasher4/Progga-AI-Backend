# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────
# PostgreSQL (e.g. Neon: https://neon.tech). Copy both strings from the Neon
# dashboard → Connect. DATABASE_URL is the *pooled* one (host contains "-pooler"),
# DIRECT_URL is the direct one (no "-pooler"); it is used by `npm run setup`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth ─────────────────────────────────────────────────
# Use a long random string in production: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── AI engine ────────────────────────────────────────────
# Starting engine: "openai" | "deepseek" | "anthropic" | "mock" (built-in offline tutor).
# If unset, the first provider with a key wins (OpenAI → DeepSeek → Claude), else mock.
# Admins can switch provider + models at runtime in the app: /admin (saved in the DB).
LLM_PROVIDER=

# Each provider uses ONE model for everything: planning steps, fact answers and checking replies.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (OpenAI-compatible API). deepseek-flash plans in ~10s; deepseek-v4-pro took ~45s in testing.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Kid-safety defaults ──────────────────────────────────
# Max new tutor problems a student can start per day (guardians can change per child)
DEFAULT_DAILY_TUTOR_LIMIT=25
